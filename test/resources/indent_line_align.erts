    (let ((f90-ts-indent-list-line 'rotate))
      (f90-ts-indent-and-complete-line)))

Name: align vardecl rotate 1
=-=
subroutine vardecl1()
     character(len=11), dimension(1:3) :: & ! comment
          
          ! comment
          
              |                    alpha = 'transparent'
end subroutine vardecl1
