Point-Char: |

Code:
  (lambda ()
    (f90-ts-mode)
    (f90-ts-mode-test-with-hs (hs-hide-block)))

Name: hideshow program 1
=-=
program main
     |print *, "hide"
end program main
=-=
program main[...]|
end program main
=-=-=

Name: hideshow module 1
=-=
module mod
     |integer :: x
end module mod
=-=
module mod[...]|
end module mod
=-=-=

Name: hideshow module 2
=-=
module mod
 |use other
contains
 subroutine sub()
 end subroutine sub
end module mod
=-=
module mod[...]|
end module mod
=-=-=

