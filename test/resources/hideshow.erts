Name: hideshow module procedure 1
=-=
submodule (mod) mod_s
contains
 module procedure sub
      |print *, "hide"
 end procedure sub
end submodule mod_s
=-=
submodule (mod) mod_s
contains
 module procedure sub[...]|
 end procedure sub
end submodule mod_s
