Name: hideshow select case statement 1
=-=
subroutine sub()
     select case (x)
     case (1)
          |print *, "one"
     case (2)
          print *, "two"
     end select
end subroutine sub
=-=
subroutine sub()
     select case (x)[...]|
     end select
end subroutine sub
