Name: hideshow select type statement 1
=-=
subroutine sub()
     select type (x)
     type is (integer)
          print *, "integer"|
     class default
          print *, "unknown"
     end select
end subroutine sub
=-=
subroutine sub()
     select type (x)[...]|
     end select
end subroutine sub
