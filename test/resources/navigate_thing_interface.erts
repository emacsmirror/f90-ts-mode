module ifc

 interface generic
      module procedure sub1
      module procedure sub2
 end interface generic

 @interface
     module pure function fun1(x, z)
          real :: fun1
          real, intent(in) :: x
          complex, intent(in) :: z
     end function fun1
     module function fun2(i, j) result(k)
          integer :: k
          integer, intent(in) :: i
          type(int_arbitrary_prec), intent(in) :: j
     end function fun2
 end interface
|
 abstract interface
      subroutine sub_ifc()
      end subroutine sub_ifc
      function fun_ifc()
           logical :: fun_ifc
      end function fun_ifc
 end interface

end module ifc
